# Copy this file to setup/.env and fill in your site. No secrets go here:
# sign-in happens in your browser (OAuth). The session is cached outside the repository
# (%LOCALAPPDATA%\samplehyperstore on Windows, ~/.config/samplehyperstore elsewhere).
# Remove it with: python scripts/tableau_auth.py logout
SERVER=https://<your-pod>.online.tableau.com
SITE_NAME=<your-site-content-url>
# Local port for the OAuth callback (change it if the port is in use)
OAUTH_CALLBACK_PORT=8799
